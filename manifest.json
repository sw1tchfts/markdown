{
  "manifest_version": 3,
  "name": "Page to Markdown",
  "version": "1.0.0",
  "description": "Save the current web page as a Markdown (.md) file.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_title": "Save page as Markdown",
    "default_popup": "popup.html"
  }
}
